# Kept release profile, sourced by ~/.claude/skills/release-to-play/{preflight,adb-helpers}.sh
PKG=com.jdevsappstudio.kept
MODULE=app
# assembleRelease builds the minified APK for the mandatory on-phone launch check (see release.md)
GATES=":app:testDebugUnitTest :app:assembleDebug :app:assembleRelease"

extra_checks() {
  local name; name=$(grep -E '^val appVersionName' app/build.gradle.kts | sed -E 's/.*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/')
  if [ -z "$name" ]; then bad "could not read appVersionName from app/build.gradle.kts"; return; fi
  local maj min pat; IFS=. read -r maj min pat <<<"$name"
  ok "appVersionName $name -> versionCode $((maj * 10000 + min * 100 + pat)) (derived)"
  git rev-parse -q --verify "refs/tags/v$name" >/dev/null && bad "tag v$name already exists - bump appVersionName first"
  [ -f keystore.properties ] || bad "keystore.properties missing - the release build would be UNSIGNED"
  [ -f app/google-services.json ] || bad "app/google-services.json missing - release has no Firebase"
  grep -rq "BuildConfig.DEBUG" app/src/main/java/com/jdevsappstudio/kept/feature/home/HomeScreen.kt || bad "Home debug panel no longer gated by BuildConfig.DEBUG"
}
